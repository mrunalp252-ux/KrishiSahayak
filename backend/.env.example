# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/krishi-sahayak

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Weather Provider Configuration
# Google Maps Platform Weather API (Primary)
# Enter your Google Maps Platform Weather API Key here:
GOOGLE_WEATHER_API_KEY=your-google-weather-api-key-here
# Optional fallback weather provider: open-meteo (keyless)
WEATHER_PROVIDER=google-weather-api

# AI Provider Configuration
# Supported providers: gemini (default), openai
AI_PROVIDER=gemini
# Your Gemini API key from Google AI Studio
# Loaded ONLY by backend server - NEVER exposed in frontend or client code
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-gemini-api-key-here
# Optional Gemini Configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Optional OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini


# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@krishisahayak.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
