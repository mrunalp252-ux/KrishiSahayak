# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/krishi-sahayak

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Weather Provider (Keyless Open-Meteo Integration)
# Krishi Sahayak uses Open-Meteo for live global agro-meteorological data.
# No API key required (keyless). No WEATHER_API_KEY needed.
WEATHER_PROVIDER=open-meteo

# AI Provider Configuration
# Supported providers: gemini (default), openai
AI_PROVIDER=gemini
# Your API key (Gemini API key from Google AI Studio or OpenAI API key)
# Loaded ONLY by backend server - NEVER exposed in frontend or client code
AI_API_KEY=your-ai-api-key-here
# Optional Gemini Configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Optional OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini


# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@krishisahayak.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
